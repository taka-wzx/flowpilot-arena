{
  "realm": "flowpilot",
  "enabled": true,
  "displayName": "FlowPilot Local Synthetic Realm",
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 0,
  "ssoSessionIdleTimeout": 600,
  "ssoSessionMaxLifespan": 1800,
  "offlineSessionIdleTimeout": 0,
  "roles": {
    "realm": [
      {
        "name": "organization_admin",
        "description": "Synthetic local organization administrator marker"
      },
      {
        "name": "operator",
        "description": "Synthetic local operator marker"
      },
      {
        "name": "auditor",
        "description": "Synthetic local auditor marker"
      }
    ]
  },
  "clients": [
    {
      "clientId": "flowpilot-control-web",
      "name": "FlowPilot Local Control Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://127.0.0.1:5173/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:5173/"
      },
      "protocolMappers": [
        {
          "name": "flowpilot-control-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "flowpilot-control-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "flowpilot-role-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "flowpilot_role",
            "claim.name": "flowpilot_role",
            "jsonType.label": "String",
            "multivalued": "false",
            "aggregate.attrs": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
