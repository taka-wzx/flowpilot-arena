{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "serviceAccount", "podSecurityContext", "containerSecurityContext", "resources", "replicas", "components"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imagePullSecrets", "existingSecret", "demo"],
      "properties": {
        "imagePullSecrets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}},
        "existingSecret": {"type": "string"},
        "demo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "realCalls", "realCostMicrousd"],
          "properties": {
            "mode": {"const": "deterministic-fake-provider"},
            "realCalls": {"const": "0"},
            "realCostMicrousd": {"const": "0"}
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"}
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runAsNonRoot", "runAsUser", "runAsGroup", "fsGroup", "seccompProfile"],
      "properties": {
        "runAsNonRoot": {"const": true},
        "runAsUser": {"const": 10001},
        "runAsGroup": {"const": 10001},
        "fsGroup": {"const": 10001},
        "seccompProfile": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "RuntimeDefault"}}}
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
      "properties": {
        "allowPrivilegeEscalation": {"const": false},
        "readOnlyRootFilesystem": {"const": true},
        "capabilities": {"type": "object", "additionalProperties": false, "required": ["drop"], "properties": {"drop": {"const": ["ALL"]}}}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"], "properties": {"cpu": {"type": "string", "minLength": 1}, "memory": {"type": "string", "minLength": 1}}},
        "limits": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"], "properties": {"cpu": {"type": "string", "minLength": 1}, "memory": {"type": "string", "minLength": 1}}}
      }
    },
    "replicas": {"type": "integer", "minimum": 1, "maximum": 2},
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlApi", "sandboxApi", "controlWeb", "sandboxWeb"],
      "properties": {
        "controlApi": {"$ref": "#/$defs/component"},
        "sandboxApi": {"$ref": "#/$defs/component"},
        "controlWeb": {"$ref": "#/$defs/component"},
        "sandboxWeb": {"$ref": "#/$defs/component"}
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "name", "image", "port", "servicePort", "healthPath", "existingSecret"],
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "digest"],
          "properties": {
            "repository": {"type": "string", "pattern": "^(|[a-z0-9./_-]+)$"},
            "digest": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"}
          }
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "servicePort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "healthPath": {"type": "string", "pattern": "^/[a-zA-Z0-9/_-]*$"},
        "existingSecret": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {"properties": {"image": {"properties": {"repository": {"pattern": "^[a-z0-9./_-]+$"}, "digest": {"pattern": "^sha256:[0-9a-f]{64}$"}}}}}
        }
      ]
    }
  }
}
